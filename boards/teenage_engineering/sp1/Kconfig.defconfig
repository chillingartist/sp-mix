# SPDX-License-Identifier: MIT

if BOARD_SP1

# The SP-1 bootloader occupies 0x00000-0x1FFFF and writes the application at
# 0x20000; link there through the devicetree code partition.
config USE_DT_CODE_PARTITION
	default y

config HW_STACK_PROTECTION
	default ARCH_HAS_STACK_PROTECTION

endif # BOARD_SP1
